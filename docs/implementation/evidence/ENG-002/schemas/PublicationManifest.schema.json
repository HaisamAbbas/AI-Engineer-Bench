{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysis_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Analysis Digest",
      "type": "string"
    },
    "approval_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Approval Digest",
      "type": "string"
    },
    "cohort_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Cohort Digest",
      "type": "string"
    },
    "evaluation_result_digests": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Evaluation Result Digests",
      "type": "array"
    },
    "excluded_trial_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Excluded Trial Ids",
      "type": "array"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "const": "aieb.publication/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "cohort_digest",
    "evaluation_result_digests",
    "analysis_digest",
    "approval_digest"
  ],
  "title": "PublicationManifest",
  "type": "object"
}
