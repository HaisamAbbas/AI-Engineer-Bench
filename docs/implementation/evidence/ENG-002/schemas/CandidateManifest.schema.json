{
  "$defs": {
    "CandidateFile": {
      "additionalProperties": false,
      "properties": {
        "byte_length": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Byte Length"
        },
        "executable": {
          "default": false,
          "title": "Executable",
          "type": "boolean"
        },
        "operation": {
          "enum": [
            "add",
            "modify",
            "delete"
          ],
          "title": "Operation",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "path",
        "operation"
      ],
      "title": "CandidateFile",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_revision_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Base Revision Digest",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/CandidateFile"
      },
      "title": "Files",
      "type": "array"
    },
    "full_tree_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Full Tree Hash",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "const": "aieb.candidate/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "base_revision_digest",
    "full_tree_hash",
    "files"
  ],
  "title": "CandidateManifest",
  "type": "object"
}
